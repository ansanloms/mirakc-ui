{
  "name": "mirakc-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:server": "node --watch --env-file-if-exists=.env server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "check": "tsc --noEmit",
    "lint": "run-s lint:oxlint lint:oxfmt",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "fix": "run-s fix:oxlint fix:oxfmt",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt",
    "test": "run-s test:server test:client",
    "test:server": "node --test \"server/**/*.test.ts\"",
    "test:client": "vitest run --coverage",
    "generate": "run-s generate:*",
    "generate:mirakc": "openapi-typescript $MIRAKC_URL/api/docs --output ./client/lib/api/schema.d.ts",
    "generate:internal": "npm --prefix ./docs/api run bundle:json && npm --prefix ./docs/api run emit-server-schemas -- ../../server/lib/api/internal-schemas.ts",
    "storybook:dev": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir ./storybook-static"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.6",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.6",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "aribb24.js": "2.0.34",
    "happy-dom": "21.0.4",
    "i18next": "27.0.1",
    "json-schema-to-ts": "3.1.1",
    "mpegts.js": "1.8.2",
    "npm-run-all2": "9.0.4",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "openapi-typescript": "7.13.0",
    "openapi-typescript-helpers": "0.1.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "6.0.3"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
