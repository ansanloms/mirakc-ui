{
  "name": "mirakc-ui-docs-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "run-s lint:check lint:oxlint lint:oxfmt lint:textlint lint:redocly",
    "lint:check": "npm run check",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "lint:textlint": "textlint . --ignore-path ./.gitignore",
    "lint:redocly": "redocly lint --config ./redocly.yaml",
    "test": "node --test \"bin/*.test.ts\"",
    "fix": "run-s --continue-on-error sort fix:textlint fix:oxlint fix:oxfmt lint",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt",
    "fix:textlint": "textlint . --fix --ignore-path ./.gitignore",
    "build": "run-s build:vite build:bundle",
    "build:vite": "vite build",
    "build:bundle": "redocly bundle ./api.yaml --config ./redocly.yaml --ext yaml --output ./dist/api.yaml",
    "bundle:json": "redocly bundle ./api.yaml --config ./redocly.yaml --dereferenced --ext json --output ./dist/api.json",
    "emit-server-schemas": "node ./bin/emit-server-schemas.ts ./dist/api.json",
    "sort": "node ./bin/sort.ts",
    "search": "node ./bin/search.ts",
    "start": "vite preview --port 4000",
    "dev": "vite"
  },
  "devDependencies": {
    "@ansanloms/redocly-plugin-inline-examples": "github:ansanloms/redocly-plugin-inline-examples#0.1.0",
    "@ansanloms/textlint-plugin-yaml-keys": "github:ansanloms/textlint-plugin-yaml-keys#0.1.0",
    "@proofdict/textlint-rule-proofdict": "3.1.2",
    "@redocly/cli": "2.75.0",
    "@stoplight/elements": "9.0.29",
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.2.1",
    "npm-run-all2": "9.0.4",
    "openapi-types": "12.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-spacing": "3.0.4",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-preset-jtf-style": "3.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-node-polyfills": "0.28.0",
    "yaml": "2.9.1"
  }
}
