# mirakc のベース URL。Web API (/api) と SSE (/events) はここから組み立てる。
MIRAKC_URL=http://example.com:40772

# 録画通知・録画ファイル名の日時整形に使うタイムゾーン (IANA タイムゾーン ID)。
# 未設定なら実行環境の既定 (Docker では UTC)。日本での視聴用途なら Asia/Tokyo を
# 設定する。クライアント (UI) の日時表示はブラウザのローカル TZ に従う (別管理)。
#TZ=Asia/Tokyo

# 設定系データ (SQLite、settings.sqlite3) の保存先ディレクトリ。未設定なら ./data。
#DATA_DIR=./data

# 設定系データの DB が空のとき (kv テーブルがまだ無いとき) だけ、このディレクトリの *.sql を名前順に実行する
# (初期データの投入)。未設定なら同梱の ./server/initdb.d (関東の実況チャンネル割り当て)。
#DATA_INIT_DIR=./server/initdb.d

# Hono (API サーバ) が listen するポート。未設定なら 8000。サーバと Vite dev server
# の両方がこの変数を読み、開発時は Vite がここへ /api をプロキシする。
#API_PORT=8000

# Vite の server.allowedHosts。カンマ区切りのホスト名、または "true" / "all" で全許可。
# Raspberry Pi 等の非 localhost 経由で開発サーバにアクセスする場合に設定する。
#VITE_ALLOWED_HOSTS=raspberrypi.local,.local

# vim:set ft=sh:
